<Window x:Class="CustomGameDB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomGameDB"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib.Controls.WPF"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        xmlns:localControles="clr-namespace:CustomGameDB.controles"
        Title="MainWindow" Height="600" Width="1000" Loaded="Window_Loaded" Language="es-ES">

    <Window.Resources>
        <Style x:Key="textBlocks" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"></Setter>
        </Style>
        <Style x:Key="tarjetaJuego" TargetType="ContentControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Margin="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="3"/>
                            </Border.Effect>
                            <ContentPresenter Margin="15"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#1E1E24">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="tabControlJuegos" Grid.Row="0" Background="#1E1E24" BorderThickness="0" Height="35" VerticalAlignment="Top" SelectionChanged="tabControlJuegos_SelectionChanged" >
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#15151A"/>
                    <Setter Property="Foreground" Value="#888899"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2A2A32"/>
                            <Setter Property="Foreground" Value="#5865F2"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>
            <TabItem Header="INICIO" Padding="10,0,15,0" Margin="0,0,5,0"/>
            <TabItem Header="MI PERFIL" Padding="10,0,15,0" Margin="0,0,5,0"/>
            <TabItem Header="AMIGOS" Padding="10,0,15,0" Margin="0,0,5,0"/>
        </TabControl>

        <Grid Grid.Row="1">

            <localControles:ConfiguracionUsuario x:Name="configuracionUsuario" Visibility="Collapsed" />
            <localControles:Amigos x:Name="amigosControl" Visibility="Collapsed" />

            <Grid x:Name="gridDatosJuegos" Visibility="Collapsed" Background="#121212">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ToolBar Grid.Row="0" VerticalAlignment="Top" Height="50" Background="#1E1E24">
                    <Button x:Name="btanterior" Click="btanterior_Click">Atras</Button>
                </ToolBar>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,10,20,0">
                            <Border Background="#1E1E1E" Height="100" Padding="10" CornerRadius="20" BorderBrush="#333" BorderThickness="0,0,0,1">
                                <TextBlock x:Name="lbName" FontSize="32" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="tbTrailer" Text="Trailer" Foreground="#BB86FC" FontWeight="Bold" Margin="0,30,0,10"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="400" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="8" x:Name="bordeImagenFondo" ClipToBounds="True" Background="Black" Visibility="Collapsed">
                                    <Image x:Name="imagenFondo" Stretch="UniformToFill"/>
                                </Border>
                                <Border Grid.Row="0" CornerRadius="8" x:Name="bordeTrailer" ClipToBounds="True" Background="Black">
                                    <wv2:WebView2 x:Name="videoControl" />
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                                    <ComboBox x:Name="cbTrailers" Width="150" SelectionChanged="cbTrailers_SelectionChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Galería de Imágenes" Foreground="#BB86FC" FontWeight="Bold" Margin="0,25,0,10"/>
                            <ListBox x:Name="capturas" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Margin="5" ClipToBounds="True">
                                            <Image Source="{Binding image}" Height="120" Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Acerca de este juego" Foreground="#BB86FC" FontWeight="Bold" Margin="0,25,0,10"/>
                            <TextBlock x:Name="tbDescripcion" Foreground="#B3B3B3" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                            <Border CornerRadius="10" Background="#1E1E1E" Padding="5" BorderThickness="1" BorderBrush="#333">
                                <wv2:WebView2 x:Name="webDescripcion" Height="400" DefaultBackgroundColor="Transparent" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,10,0,0">
                            <Border Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,5">
                                        <TextBlock Text="PLATAFORMAS" FontSize="10" Foreground="#BB86FC" FontWeight="Bold"/>
                                        <TextBlock x:Name="tbPlataformas" Foreground="White" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,5">
                                        <TextBlock Text="GENEROS" FontSize="10" Foreground="#BB86FC" FontWeight="Bold"/>
                                        <TextBlock x:Name="tbGeneros" Foreground="White" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,5">
                                        <TextBlock Text="TIENDAS" FontSize="10" Foreground="#BB86FC" FontWeight="Bold"/>
                                        <TextBlock x:Name="tbTiendas" Foreground="White" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Margin="0,15">
                                        <TextBlock Text="LANZAMIENTO" FontSize="10" Foreground="#BB86FC" FontWeight="Bold"/>
                                        <TextBlock x:Name="tbFechaLanzamiento" Foreground="White" FontSize="16"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Margin="0,15">
                                        <TextBlock Text="HORAS JUGADAS DE MEDIA" FontSize="10" Foreground="#BB86FC" FontWeight="Bold"/>
                                        <TextBlock x:Name="tbHorasJugadas" Foreground="White" FontSize="16"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5">
                                        <TextBlock Text="METACRITIC" FontSize="10" Foreground="#BB86FC" FontWeight="Bold"/>
                                        <Border Background="#66CC33" HorizontalAlignment="Left" CornerRadius="4" Padding="5,2">
                                            <TextBlock x:Name="tbMetacritic" FontWeight="Bold" Foreground="Black"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="#252525" CornerRadius="10" Padding="20" BorderBrush="#333" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="MI RESEÑA" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                    <Label Content="Nota Personal (1-100):" Foreground="White" Background="#5865F2"/>
                                    <Slider x:Name="sliderNota" Minimum="1" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock x:Name="tbSliderNota" Text="{Binding ElementName=sliderNota, Path=Value}" HorizontalAlignment="Right" Foreground="#5865F2"/>
                                    <Label Content="Estado del Juego:" Foreground="White" Margin="0,10,0,0" Background="#5865F2"/>
                                    <ComboBox x:Name="cbEstado">
                                        <ComboBoxItem Content="Pendiente" IsSelected="True"/>
                                        <ComboBoxItem Content="Iniciado"/>
                                        <ComboBoxItem Content="Terminado"/>
                                        <ComboBoxItem Content="Abandonado"/>
                                    </ComboBox>
                                    <CheckBox x:Name="chbFavorito" Content="Añadir a Favoritos" Foreground="White" Background="#5865F2" Margin="0,15"/>
                                    <Label Content="Comentarios:" Foreground="White" Background="#5865F2"/>
                                    <TextBox x:Name="tbReview" Height="200" TextWrapping="Wrap" AcceptsReturn="True" Background="#333" Foreground="White" BorderThickness="0" CaretBrush="White" VerticalScrollBarVisibility="Auto" ScrollViewer.IsDeferredScrollingEnabled="True"/>
                                    <Label Content="Horas jugadas por ti:" Foreground="White" Background="#5865F2"/>
                                    <TextBox x:Name="tbHorasJugadasPersonal" Background="#333" Foreground="White" BorderThickness="0" CaretBrush="White" Margin="0,5,0,15" PreviewTextInput="tbHorasJugadasPersonal_PreviewTextInput" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="tbSeleccionarRuta" IsEnabled="False" Background="#333" Foreground="White" BorderThickness="0" CaretBrush="White" Margin="0,5,0,15" />
                                        <Button x:Name="btnRuta" Content="Seleccionar Ruta Executable" Margin="0,15,0,5" Grid.Column="1" Padding="5" Click="btnRuta_Click" />
                                    </Grid>
                                    
                                    <Button x:Name="btnGuardar" Content="GUARDAR CAMBIOS" Background="#5865F2" Foreground="Black" FontWeight="Bold" Height="40" Margin="0,10,0,0" Click="btnGuardar_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="dgDatosJuegos" Background="#1E1E24" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0" HorizontalAlignment="Stretch" Background="#1E1E24" BorderThickness="0">
                    <Button x:Name="BtBuscar2" Content="Buscar:" Click="BtBuscar2_Click" Foreground="White" Background="#5865F2" />
                    <TextBox x:Name="tbBuscar2" Width="100" KeyDown="tbBuscar2_KeyDown" Background="#2A2A32" Foreground="White" VerticalContentAlignment="Center"/>
                    <Button x:Name="btanterior2" Click="btanterior2_Click" Foreground="White" Background="#5865F2" >Atras</Button>
                    <Label Background="#2A2A32" Foreground="White" >Filtrar por tienda:</Label>
                    <ComboBox x:Name="cbTiendas2" Width="80" Background="#2A2A32" Foreground="White"></ComboBox>
                    <Label Background="#2A2A32" Foreground="White">Filtrar por género:</Label>
                    <ComboBox x:Name="cbGeneros2" Width="80" Background="#2A2A32" Foreground="White"></ComboBox>
                    <Label Background="#2A2A32" Foreground="White">Filtrar por plataforma:</Label>
                    <ComboBox x:Name="cbPlataformas2" Width="80" Background="#2A2A32" Foreground="White"></ComboBox>
                </ToolBar>

                <ScrollViewer Grid.Row="1" ScrollChanged="Games_ScrollChanged" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="itemsControlJuegos" >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Style="{StaticResource tarjetaJuego}" Width="220" MouseDown="Tarjeta_MouseDown">
                                    <StackPanel>
                                        <Image Source="{Binding background_image}" Height="140" Stretch="Fill"/>
                                        <TextBlock Text="{Binding name}" FontWeight="Bold" Margin="0,5" Foreground="Black"/>
                                    </StackPanel>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Window>
