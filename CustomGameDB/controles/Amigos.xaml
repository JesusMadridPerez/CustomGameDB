<UserControl x:Class="CustomGameDB.controles.Amigos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomGameDB.controles"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="MIS AMIGOS" 
                   Foreground="White" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>
        <TextBlock Text="Juegos con reseñas de amigos" 
           Grid.Column="1"
           Foreground="White" 
           FontSize="24" 
           FontWeight="Bold" 
           Margin="0,0,0,20"/>
        <DataGrid x:Name="dgAmigos" 
                  Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  Background="#252526" 
                  RowBackground="#2D2D30" 
                  AlternatingRowBackground="#333337"
                  Foreground="White" 
                  BorderBrush="#3F3F46"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3F3F46"
                  RowHeight="40"
                  CanUserAddRows="False">

            <DataGrid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn x:Name="colNombreAmigo" Header="Nombre de Usuario" 
                                    Binding="{Binding NombreAmigo}" 
                                    Width="*" 
                                    FontSize="14"
                                    >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="10,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="Ver Juegos" 
                                        Click="BtnVerJuegos_Click" 
                                        Margin="5,0"/>

                                <Button Content="Chat" 
                                        Background="#107C41" Click="BtnChat_Click" 
                                        Margin="5,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="dgReviews" 
            AutoGenerateColumns="False" 
            IsReadOnly="True"
            Grid.Row="1"
            Grid.Column="1"
            RowDetailsVisibilityMode="VisibleWhenSelected" Background="#1E1E24" 
            RowBackground="#2A2A32" 
            AlternatingRowBackground="#22222A"
            Foreground="White"
            GridLinesVisibility="Horizontal"
            HorizontalGridLinesBrush="#444">        
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2196F3"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,5,10,5"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="120"/>

                <DataGridTextColumn Header="Juego" Binding="{Binding NombreJuego}" Width="*" FontWeight="Bold"/>

                <DataGridTextColumn Header="Horas Jugadas" Binding="{Binding HorasJugadas, StringFormat={}{0} hrs}" Width="110"/>

                <DataGridTextColumn Header="Nota" Binding="{Binding NotaPersonal, StringFormat={}{0}/10}" Width="60"/>

                <DataGridTextColumn Header="Estado" Binding="{Binding EstadoJuego}" Width="100"/>
            </DataGrid.Columns>


            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#15151A" Padding="15" BorderThickness="0,1,0,1" BorderBrush="#444">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="RESEÑA DEL USUARIO:" FontSize="10" FontWeight="Bold" Foreground="#888" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding ReviewTexto}" Foreground="LightGray" TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>

                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

    </Grid>
</UserControl>
