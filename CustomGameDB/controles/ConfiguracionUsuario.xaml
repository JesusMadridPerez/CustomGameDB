<UserControl x:Class="CustomGameDB.controles.ConfiguracionUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomGameDB.controles"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000" Loaded="UserControlLoaded" >

    <Grid Background="#2A2A32" Margin="0,35,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2A2A32" CornerRadius="12" Margin="10" Padding="20,30,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid HorizontalAlignment="Center" Margin="0,10,0,20">
                        <Ellipse Width="80" Height="80" Fill="#1E1E24"/>
                        <TextBlock Text="&#xE77B;" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   FontSize="45" 
                                   Foreground="#00FF88" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Mi Perfil" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="Nombre de Usuario:" Foreground="#888899" FontSize="12" Margin="0,10,0,2"/>
                    <TextBlock x:Name="TxtNombre" Text="GamerPro_99" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <TextBlock Text="Correo Electrónico:" Foreground="#888899" FontSize="12" Margin="0,10,0,2"/>
                    <TextBlock x:Name="TxtCorreo" Text="gamerpro@email.com" Foreground="White" FontSize="14" Margin="0,0,0,15"/>

                    <TextBlock Text="Fecha de Nacimiento:" Foreground="#888899" FontSize="12" Margin="0,10,0,2"/>
                    <TextBlock x:Name="TxtFechaNac" Text="15 / 08 / 2002" Foreground="White" FontSize="14" Margin="0,0,0,15"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Buscar Usuarios:" Foreground="#888899" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="InputBusqueda" Height="30" Background="#15151A" Foreground="White" BorderBrush="#444454" BorderThickness="1" Padding="8,5,8,5" VerticalContentAlignment="Center" FontSize="14"/>
                    <TextBlock x:Name="LblResultados" Text="aceptar solicitudes" Foreground="#888899" FontSize="12" Margin="0,10,0,5"/>
                    <DataGrid x:Name="dgsolicitudesSinAceptar" Height="100" Background="#15151A" BorderBrush="#444454" Foreground="Black">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,5,10,5"/>
                            </Style>
                        </DataGrid.Resources>

                    </DataGrid>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Top" Margin="10,21,0,0">
                    <Button x:Name="BtnBuscar" Content="Buscar Usuario" Width="130" Height="30" Margin="0,0,0,35" Background="#5865F2" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnBuscar_Click"/>
                    <Button Height="30" Width="130" Margin="0,30,0,0" Background="#5865F2" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnAgregarAmigo_Click">Aceptar solicitud</Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblSeccionJuegos" Text="Mis Juegos Favoritos" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                <CheckBox x:Name="chkFavoritos" Grid.Column="1" Foreground="White" Checked="chkFavoritos_Checked" Unchecked="chkFavoritos_Unchecked"  >Solo juegos favoritos</CheckBox>
                
            </Grid>
            
            
                <DataGrid x:Name="dgReviews" 
          AutoGenerateColumns="False" 
          IsReadOnly="True"
          Grid.Row="2"
          RowDetailsVisibilityMode="VisibleWhenSelected" Background="#1E1E24" 
          RowBackground="#2A2A32" 
          AlternatingRowBackground="#22222A"
          Foreground="White"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#444">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2196F3"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5,10,5"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Visibility="Collapsed" Binding="{Binding NombreUsuario}" Width="120"/>

                        <DataGridTextColumn Header="Juego" Binding="{Binding NombreJuego}" Width="*" FontWeight="Bold"/>

                        <DataGridTextColumn Header="Horas Jugadas" Binding="{Binding HorasJugadas, StringFormat={}{0} hrs}" Width="110"/>

                        <DataGridTextColumn Header="Nota" Binding="{Binding NotaPersonal, StringFormat={}{0}/10}" Width="60"/>

                        <DataGridTextColumn Header="Estado" Binding="{Binding EstadoJuego}" Width="100"/>
                    </DataGrid.Columns>
                    

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#15151A" Padding="15" BorderThickness="0,1,0,1" BorderBrush="#444">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="RESEÑA DEL USUARIO:" FontSize="10" FontWeight="Bold" Foreground="#888" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding ReviewTexto}" Foreground="LightGray" TextWrapping="Wrap" FontSize="13"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" 
                            Content="▶ JUGAR" 
                            Width="100" 
                            Height="35" 
                            Background="#007ACC" 
                            Foreground="White" 
                            FontWeight="Bold"
                            Cursor="Hand"
                            CommandParameter="{Binding RutaJuego}"
                            Click="BtnJugar_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            
        </Grid>
    </Grid>
</UserControl>